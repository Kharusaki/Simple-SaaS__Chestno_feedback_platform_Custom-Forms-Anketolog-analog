# Скопируй этот файл в .env и при необходимости поменяй значения.
# Реальный .env в git не попадает (см. .gitignore).

# --- База данных ---
# Обычно эту строку задавать не нужно: по умолчанию база — survey.db в корне
# проекта, и она привязана к нему, а не к папке запуска.
#
# Раскомментируй, только если база лежит в другом месте, и укажи ПОЛНЫЙ путь.
# Относительный путь (например sqlite:///./survey.db) разрешается от ТЕКУЩЕЙ
# папки: запустишь приложение из соседнего каталога — получишь вторую пустую
# базу и пустой кабинет при живых данных в старой.
#   Windows: DATABASE_URL=sqlite:///C:/полный/путь/survey.db
#   Linux/macOS: DATABASE_URL=sqlite:////полный/путь/survey.db
# Внешний сервер: postgresql+psycopg://user:pass@host:5432/surveys

# --- Секрет для подписи cookie сессии ---
# ОБЯЗАТЕЛЬНО заменить в продакшене. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# С ключом меняются все cookie: старые входы перестанут работать.
SECRET_KEY=dev-secret-key-change-me-in-production

# --- Ссылки на анкеты ---
# Сколько символов в адресе вида /s/a82jd92k. Меньше — короче ссылка,
# но проще подобрать. Допустимо от 4 до 24.
SLUG_LENGTH=8

# --- Cookie ---
COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_MAX_AGE=2592000

# --- Администратор: фон сайта, логотип, обложки анкет ---
# Учётка заводится сама при первом запуске, если администратора ещё нет.
# Эти значения используются только для её создания: сменил пароль в
# /account/password — и дальше действует он, а не то, что здесь.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Включи false на боевом сервере, если аккаунты создаёт администратор.
ALLOW_REGISTRATION=true

# --- Загруженные картинки оформления ---
# Папка внутри проекта, создаётся сама. Не клади её в git.
MEDIA_DIR_NAME=media
# Максимальный размер одной картинки в байтах (по умолчанию 2 МБ).
MAX_UPLOAD_BYTES=2097152

# --- Cookie респондента (для «Мои ответы» и защиты от повторной отправки) ---
RESPONDENT_COOKIE_NAME=respondent_id
RESPONDENT_COOKIE_MAX_AGE=31536000

# --- Redis (необязателен: без него работает in-memory фолбэк) ---
# Оставь пустым, чтобы приложение работало без внешних сервисов.
# В Docker Compose уже задано: redis://redis:6379/0
REDIS_URL=
# Сколько секунд живёт закешированная статистика анкеты.
# Статистика инвалидируется сама при новом ответе, правке и удалении анкеты.
REDIS_TTL_SECONDS=30

# --- Лимиты частоты (0 — выключить) ---
# Считаются по IP посетителя. В Redis — общий счётчик на все процессы,
# без Redis — только внутри одного процесса.
RATE_LIMIT_CREATE_PER_HOUR=20
RATE_LIMIT_SUBMIT_PER_MINUTE=10
RATE_LIMIT_PAGE_PER_MINUTE=300

# --- Приложение ---
APP_NAME=Опросы
DEBUG=true
HOST=127.0.0.1
PORT=8000
